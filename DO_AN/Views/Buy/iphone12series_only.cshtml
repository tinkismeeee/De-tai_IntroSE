<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>ProductCategory</title>
    <link rel="stylesheet" href="/css/Product_category.css?v=3" />
    <script src="https://kit.fontawesome.com/3e21e075ef.js" crossorigin="anonymous"></script>
</head>
<body>
    @* <div style="padding: 5px 4.3%; background: white; height: fit-content"><span style="padding:0px 30px;font-size:15px; color: rgb(81,81,84)">Home > iPhone</span></div> *@
    <div class="breadcrumb">
        <ul itemscope="" itemtype="http://schema.org/BreadcrumbList" style="list-style-type: none; flex-wrap: nowrap; display: inline-block; white-space: nowrap;">
            <li itemprop="itemListElement" itemscope="" itemtype="http://schema.org/ListItem"><a href="/" title="Trang chủ" itemprop="item" style="text-decoration: none;">Trang chủ</a> 
                <span class="delimiter">›</span>
                <span class="delimiter"><a title="iPhone">iPhone</a></span>
                <meta itemprop="position" content="1"><meta itemprop="name" content="Trang chủ">
            </li>
        </ul>
    </div>
    <section>
        <div class="slider">
            <button class="btn left"><i class="fa-solid fa-chevron-left"></i></button>
            <button class="btn right"><i class="fa-solid fa-chevron-right"></i></button>
            <img id="main_img" src="">
            <div class="slide_img">
                <img src="https://shopdunk.com/images/uploaded/banner/Banner%202025/Thang_6/danh%20m%E1%BB%A5c-ip_Danh%20m%E1%BB%A5c.png" class="imgs">
                <img src="https://shopdunk.com/images/uploaded/banner/Banner%202025/Thang_6/danh%20m%E1%BB%A5c-ip_Danh%20m%E1%BB%A5c%20copy.png" class="imgs">
                <img src="https://shopdunk.com/images/uploaded/banner/Banner%202025/Thang_6/danh%20m%E1%BB%A5c-ip_Danh%20m%E1%BB%A5c%20copy%202.png" class="imgs">
                <img src="https://shopdunk.com/images/uploaded/may-cu/danh%20m%E1%BB%A5c-m%C3%A1y%20c%C5%A9_Danh%20m%E1%BB%A5c.png" class="imgs">
                <img src="/img/banner iphone 14 Pro Max.jpg" class="imgs">
                <img src="/img/iphone_slider2.jpg" class="imgs">
                <img src="https://shopdunk.com/images/uploaded/banner/Banner%20th%C3%A1ng%208/banner%20apple%20pay_Banner%20PC.jpg" class="imgs">
                <img src="https://shopdunk.com/images/uploaded/banner/Banner%20th%C3%A1ng%208/PC.png" class="imgs">
            </div>
        </div>
        <div class="Series_Iphone" style="padding: 50px 0 30px 7%;"><a href="/Home/Privacy"><span>All</span></a> <a href="/Buy/iphone16series_only"><span>iPhone 16 series</span></a> <a href="/Buy/iphone15series_only"><span>iPhone 15 series</span></a> <a href="/Buy/iphone14series_only"><span>iPhone 14 series</span><a href="/Buy/iphone13series_only"><span>iPhone 13 series</span></a></a>  <a href="/Buy/iphone12series_only"><span>iPhone 12 series</span></a> <a href="/Buy/iphone11series_only"><span>iPhone 11 series</span></a> </div>
        <!--Dong 1-->
        <div class="equipment-boss">
            <div class="classify_equipment">
                <div class="equipment">
                    <a href="#"><img style="width:auto;float:right;max-width: 30%; height:auto;margin-top: -10px" src="/img/het_hang.png" /></a>
                    <br />
                    <img style="padding:0 1%;width: 240px;height: 240px;margin-top: -25px" title="iPhone 12" src="https://shopdunk.com/images/thumbs/0006794_iphone-12-64gb_240.png" />
                    <p class="name_equipment" style="font-size: 20px; font-weight: bolder; margin-top: 24px">iPhone 12 64GB</p>
                    <div class="price-container">
                        <p class="price" style="color: rgb(134,134,139) ">
                            <span class="actual-price" style="color: rgb(0,101,204); font-weight:bold">Tạm hết hàng</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* <div class="next_page" style="text-align:center">
            <a href="@Url.Action("Privacy","Home")"><span><i class="fa-solid fa-chevron-left"></i></span></a>
            <a href="/Home/Privacy" style="text-decoration: none;"><span style="cursor: pointer;">1</span></a>
            <a href="/Home/iphone_page_2" style="text-decoration: none;"><span style=" background-color: white; color: black; cursor: pointer">2</span></a>
            <a href="@Url.Action("iphone_page_2","Home")"><span><i class="fa-solid fa-chevron-right"></i></span></a>
        </div> *@
    </section>
    <script src="~/js/HomepageJS.js"></script>
</body>
</html>
