<head>
    <meta charset="utf-8" />
    <title>Tên title</title>
    <link rel="stylesheet" href="~/css/iPhone_Buy/iphone16_128gb.css" />
    <script src="https://kit.fontawesome.com/3e21e075ef.js" crossorigin="anonymous"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <div class="breadcrumb">
        <ul itemscope="" itemtype="http://schema.org/BreadcrumbList" style="list-style-type: none; flex-wrap: nowrap; display: inline-block; white-space: nowrap;">
            <li itemprop="itemListElement" itemscope="" itemtype="http://schema.org/ListItem">
                <a href="/" title="Trang chủ" itemprop="item" style="text-decoration: none;">Trang chủ</a>
                <span class="delimiter">›</span>
                <span class="delimiter"><a title="iPhone">iPhone</a></span>
                <span class="delimiter">›</span>
                <span class="delimiter"><a title="iPhone 16 128GB">iPhone 16 128GB</a></span>
                <meta itemprop="position" content="1"><meta itemprop="name" content="Trang chủ">
            </li>
        </ul>
    </div>
    <section class="center">
        <div class="media-section">
            <div class="video-grid">
                <iframe width="500" height="500" src="https://www.youtube.com/embed/knkR8YTWTU8" title="iPhone 16" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
            <div class="image-grid"></div>
        </div>
        <div class="info-section">
            <div class="product-name">
                <h1>iPhone 16 128GB</h1>
            </div>
            <div class="storelocation-all">
                <select class="location" name="product-attribute" id="product-attribute">
                    <option value="0" selected="selected">Vui lòng chọn</option>
                    <option value="1" >Khu vực miền Bắc</option>
                    <option value="2">Khu vực miền Nam</option>
                </select>
            </div>
            <div class="price">
                <span class="actual-price">18.890.000₫</span>
                <span class="old-price">22.990.000₫</span>
                <p>(Đã bao gồm VAT)</p>
            </div>
            <p>Dung lượng:</p>
            <div class="storage-capacity">
                <ul class="capacity-option">
                    <li>
                        <p>128GB</p>
                    </li>
                    <li>
                        <p>256GB</p>
                    </li>
                    <li>
                        <p>512GB</p>
                    </li>
                </ul>
            </div>
            <p>Màu sắc:</p>
            <div class="color-option">
                <ul class="color-select">
                    <li class="color-black" title="Đen"></li>
                    <li class="color-white" title="Trắng"></li>
                    <li class="color-pink" title="Hồng"></li>
                    <li class="color-lapis" title="Xanh lưu ly"></li>
                    <li class="color-mint" title="Xanh mòng két"></li>
                </ul>
            </div>
        </div>
        <div class="other-section">

        </div>
    </section>
</body>