<body>
    <!-- HEADER -->
    <div class="top-header">
        <div class="logo">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/img/UMT_logo.png" asp-append-version="true" />
            </a>
        </div>
        <ul class="menu" style="margin-right: 150px">
            <li><a href="#">BẢO HÀNH MỞ RỘNG</a></li>
            <li><a href="#">BẢO HÀNH KIM CƯƠNG</a></li>
            <li><a href="#">THU CŨ ĐỔI MỚI</a></li>
            <li><a href="#">TRẢ GÓP</a></li>
            <li><a asp-controller="Home" asp-action="Index">MUA HÀNG TẠI UMT</a></li>
        </ul>
        <div class="lang-flag">
            @* <img src="~/img/flagVN.jpg" asp-append-version="true" /> *@
        </div>
    </div>

    <!-- BANNER -->
    <div class="banner">
        <div class="banner-container">
            <div class="banner-image">
                <img src="~/img/test.png" alt="Apple Products" asp-append-version="true" />
            </div>
            <div class="banner-text">
                <h2>TRUNG TÂM BẢO HÀNH VÀ SỬA CHỮA<br />ỦY QUYỀN APPLE</h2>
                <p>Dễ dàng tiếp nhận tại hơn 40 cửa hàng UMT và UMT Care trên toàn quốc.</p>
                <a href="#">Đặt lịch ngay</a>
            </div>
        </div>
    </div>

    


</body>

